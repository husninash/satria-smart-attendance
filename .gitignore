# Root .gitignore for SATRIA Smart Attendance (Monorepo)

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary runtime directories
.sites-runtime/

# Backend (Laravel)
backend/database/*.sqlite
backend/database/*.sqlite-journal
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.backup
backend/.env.production
backend/storage/*.key
backend/storage/pail
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
!backend/storage/framework/cache/.gitignore
!backend/storage/framework/sessions/.gitignore
!backend/storage/framework/views/.gitignore
!backend/storage/logs/.gitignore
backend/public/storage
backend/public/hot
backend/public/build
backend/.phpunit.result.cache

# Frontend (Next.js / Vite / React)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/
frontend/.wrangler/
frontend/.sites-runtime/
frontend/coverage/
frontend/*.log
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/.pnpm-debug.log*
frontend/.env*
!frontend/.env.example
frontend/.vercel/
frontend/tsconfig.tsbuildinfo
